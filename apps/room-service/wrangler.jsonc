{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quorum-room-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      }
    ]
  },
  "exports": {
    "RoomDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
